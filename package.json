{
  "name": "rector-vscode",
  "displayName": "Rector",
  "description": "Rector - Instant Upgrades and Automated Refactoring",
  "icon": "icon.png",
  "version": "1.0.0",
  "publisher": "vix",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "qna": false,
  "preview": false,
  "pricing": "Free",
  "author": {
    "name": "Anton VIX",
    "email": "Gordan.ei@protonmail.ch",
    "url": "https://github.com/vix-4800"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "php",
    "rector",
    "refactoring",
    "code quality"
  ],
  "activationEvents": [
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Rector executes the configured Rector binary against workspace files."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Rector requires filesystem access to PHP files, Rector configuration, and the Rector executable."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "rector.processFile",
        "title": "Process Current File",
        "category": "Rector"
      },
      {
        "command": "rector.processFileWithDiff",
        "title": "Process Current File (Show Diff)",
        "category": "Rector"
      },
      {
        "command": "rector.processFiles",
        "title": "Refactor Selected Files/Folders",
        "category": "Rector"
      },
      {
        "command": "rector.clearCache",
        "title": "Clear Cache",
        "category": "Rector"
      },
      {
        "command": "rector.showOutput",
        "title": "Show Output",
        "category": "Rector"
      },
      {
        "command": "rector.applyDiffChanges",
        "title": "Apply Diff Changes",
        "category": "Rector",
        "icon": "$(check)"
      },
      {
        "command": "rector.discardDiffChanges",
        "title": "Discard Diff Changes",
        "category": "Rector",
        "icon": "$(close)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Rector",
      "properties": {
        "rector.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable Rector"
        },
        "rector.executablePath": {
          "type": "string",
          "default": "rector",
          "scope": "resource",
          "description": "Path to Rector executable"
        },
        "rector.configPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Path to Rector config file (leave empty for auto-detection)"
        },
        "rector.enableAutofix": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Automatically apply Rector fixes on save"
        },
        "rector.showDiffOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Show diff view before applying changes on save"
        },
        "rector.clearCacheBeforeRun": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Clear Rector cache before each run"
        },
        "rector.timeout": {
          "type": "number",
          "default": 60000,
          "scope": "resource",
          "description": "Timeout for Rector process in milliseconds (default: 60000ms = 60s)"
        },
        "rector.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable CodeLens buttons for running Rector in PHP files"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "rector.processFile",
          "when": "editorLangId == php"
        },
        {
          "command": "rector.processFileWithDiff",
          "when": "editorLangId == php"
        },
        {
          "command": "rector.applyDiffChanges",
          "when": "false"
        },
        {
          "command": "rector.discardDiffChanges",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "rector.applyDiffChanges",
          "when": "resourceFilename =~ /\\.rector\\.tmp\\.php$/ || resourceFilename =~ /\\\\.rector\\\\.tmp\\\\.php$/",
          "group": "navigation@1"
        },
        {
          "command": "rector.discardDiffChanges",
          "when": "resourceFilename =~ /\\.rector\\.tmp\\.php$/ || resourceFilename =~ /\\\\.rector\\\\.tmp\\\\.php$/",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "rector.processFile",
          "when": "editorLangId == php",
          "group": "1_modification"
        },
        {
          "command": "rector.processFileWithDiff",
          "when": "editorLangId == php",
          "group": "1_modification"
        }
      ],
      "explorer/context": [
        {
          "command": "rector.processFiles",
          "when": "explorerResourceIsFolder || resourceExtname == .php",
          "group": "2_workspace"
        }
      ]
    }
  },
  "homepage": "https://github.com/vix-4800/rector-vsc",
  "repository": {
    "type": "git",
    "url": "https://github.com/vix-4800/rector-vsc.git"
  },
  "bugs": {
    "url": "https://github.com/vix-4800/rector-vsc/issues"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "package": "npm run check-types && npm run lint && npm run compile",
    "package:vsix": "npx @vscode/vsce package",
    "prerelease": "npm run package && npm test && npm run package:vsix",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:unit": "npm run compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.118",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^10.3.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
